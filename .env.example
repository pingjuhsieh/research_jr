# Copy to .env and set your key:
#   cp .env.example .env

OPENAI_API_KEY=

# Step 2 models (printed at startup — change here, not only in pipeline_config.py)
# gpt-5-mini uses max_completion_tokens (handled automatically in code)
OPENAI_MODEL_DISCOVERY=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_EXTRACT=gpt-4.1-mini-2025-04-14
OPENAI_MODEL_CLASSIFY=gpt-4.1-mini-2025-04-14

LLM_TEMPERATURE=0
LLM_SEED=42
MAX_SPAN_CHARS=4500
MAX_CONTEXT_CHARS=2000
MIN_SPAN_WORDS=15
MAX_LLM_RETRIES=5
LLM_MAX_WORKERS=10
# gpt-5-mini discovery: use >=2000 (reasoning tokens count toward the cap)
DISCOVERY_MAX_TOKENS=4000
EXTRACT_MAX_TOKENS=6000
# Extract: false avoids duplicating pairs from adjacent blocks (discovery still uses context)
EXTRACT_INCLUDE_CONTEXT=false
# Step 2: set true to print every LLM retry
STEP2_VERBOSE=false
# Lower = less hidden reasoning (gpt-5/o-series): minimal | low | medium | high
OPENAI_REASONING_EFFORT_DISCOVERY=minimal
OPENAI_REASONING_EFFORT_EXTRACT=low

# Do not write __pycache__ (run everything from project root via uv)
PYTHONDONTWRITEBYTECODE=1
